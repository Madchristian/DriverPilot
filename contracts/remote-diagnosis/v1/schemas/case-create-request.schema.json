{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnosebericht: Request von POST /cases",
  "description": "Explizite Transportprojektion. Jedes Feld ist Pflicht; ein unbekannter Wert ist null und wird nie durch einen Ersatzwert erfunden. Unbekannte Felder werden abgelehnt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_version",
    "scan_id",
    "scanned_at",
    "observation_start",
    "observation_end",
    "previous_case_id",
    "symptom",
    "hardware",
    "devices",
    "findings",
    "collection",
    "wow",
    "consent"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1"] },
    "app_version": { "type": "string", "pattern": "^[0-9]{1,5}(\\.[0-9]{1,5}){2,3}$" },
    "scan_id": {
      "description": "Vom Client je Scan erzeugte UUID.",
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "scanned_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "observation_start": { "$ref": "common.schema.json#/$defs/timestamp" },
    "observation_end": { "$ref": "common.schema.json#/$defs/timestamp" },
    "previous_case_id": {
      "description": "Optionaler Verweis auf einen eigenen früheren Fall.",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
    },
    "symptom": { "$ref": "#/$defs/symptom" },
    "hardware": { "$ref": "#/$defs/hardware" },
    "hardware_details": {
      "description": "Ab Version 1.1: Detailangaben zu CPU, Arbeitsspeicher, Grafikkarten, Laufwerken und Plattform. null, wenn die Erfassung insgesamt fehlschlug.",
      "anyOf": [{ "$ref": "#/$defs/hardware_details" }, { "type": "null" }]
    },
    "devices": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/device" }
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/finding" }
    },
    "collection": { "$ref": "#/$defs/collection" },
    "wow": {
      "anyOf": [{ "$ref": "#/$defs/wow" }, { "type": "null" }]
    },
    "consent": { "$ref": "#/$defs/consent" }
  },
  "allOf": [
    {
      "description": "hardware_details ist ab Version 1.1 Pflicht und in Version 1.0 ein unbekanntes Feld.",
      "if": { "properties": { "schema_version": { "const": "1.0" } } },
      "then": { "not": { "required": ["hardware_details"] } },
      "else": { "required": ["hardware_details"] }
    }
  ],
  "$defs": {
    "nullable_technical_text": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/technical_text" }, { "type": "null" }]
    },
    "symptom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "description", "reproduction_steps", "occurred_at"],
      "properties": {
        "category": {
          "enum": ["wow_crash", "pc_freeze", "graphics_reset", "performance", "network", "addon_error", "other"]
        },
        "description": {
          "$ref": "common.schema.json#/$defs/free_text",
          "minLength": 1,
          "maxLength": 2000
        },
        "reproduction_steps": {
          "anyOf": [
            { "$ref": "common.schema.json#/$defs/free_text", "minLength": 1, "maxLength": 2000 },
            { "type": "null" }
          ]
        },
        "occurred_at": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }]
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_version",
        "windows_build",
        "architecture",
        "cpu",
        "ram_gb",
        "system_manufacturer",
        "system_model",
        "is_portable",
        "board_manufacturer",
        "board_model",
        "board_revision",
        "bios_version",
        "bios_date"
      ],
      "properties": {
        "windows_version": { "$ref": "#/$defs/nullable_technical_text" },
        "windows_build": {
          "anyOf": [{ "type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6})?$" }, { "type": "null" }]
        },
        "architecture": { "enum": ["x64", "arm64", "x86", null] },
        "cpu": { "$ref": "#/$defs/nullable_technical_text" },
        "ram_gb": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 },
        "system_manufacturer": { "$ref": "#/$defs/nullable_technical_text" },
        "system_model": { "$ref": "#/$defs/nullable_technical_text" },
        "is_portable": { "type": ["boolean", "null"] },
        "board_manufacturer": { "$ref": "#/$defs/nullable_technical_text" },
        "board_model": { "$ref": "#/$defs/nullable_technical_text" },
        "board_revision": { "$ref": "#/$defs/nullable_technical_text" },
        "bios_version": { "$ref": "#/$defs/nullable_technical_text" },
        "bios_date": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/date" }, { "type": "null" }]
        }
      }
    },
    "hardware_details": {
      "description": "Jeder Bereich ist null, wenn er nicht erfasst werden konnte; null ist nie ein unauffälliger Befund. Keine Seriennummern.",
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory", "gpus", "storage", "platform"],
      "properties": {
        "cpu": { "anyOf": [{ "$ref": "#/$defs/cpu_details" }, { "type": "null" }] },
        "memory": { "anyOf": [{ "$ref": "#/$defs/memory_details" }, { "type": "null" }] },
        "gpus": {
          "anyOf": [{ "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/gpu" } }, { "type": "null" }]
        },
        "storage": { "anyOf": [{ "$ref": "#/$defs/storage_details" }, { "type": "null" }] },
        "platform": { "anyOf": [{ "$ref": "#/$defs/platform_details" }, { "type": "null" }] }
      }
    },
    "cpu_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cores", "threads", "max_clock_mhz"],
      "properties": {
        "cores": { "type": ["integer", "null"], "minimum": 1, "maximum": 1024 },
        "threads": { "type": ["integer", "null"], "minimum": 1, "maximum": 4096 },
        "max_clock_mhz": { "description": "Nenntakt laut Windows (Win32_Processor.MaxClockSpeed), kein Boost-Takt.", "type": ["integer", "null"], "minimum": 100, "maximum": 10000 }
      }
    },
    "memory_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots_total", "modules"],
      "properties": {
        "slots_total": { "type": ["integer", "null"], "minimum": 1, "maximum": 64 },
        "modules": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/memory_module" } }
      }
    },
    "memory_module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "capacity_mb", "type", "rated_mts", "configured_mts", "manufacturer", "part_number"],
      "properties": {
        "slot": { "description": "Steckplatzbezeichnung des Herstellers, zum Beispiel DIMM_A2.", "$ref": "#/$defs/nullable_technical_text" },
        "capacity_mb": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 },
        "type": { "enum": ["ddr3", "ddr4", "ddr5", "lpddr4", "lpddr5", "other", null] },
        "rated_mts": { "description": "Nenngeschwindigkeit des Moduls in MT/s.", "type": ["integer", "null"], "minimum": 1, "maximum": 20000 },
        "configured_mts": { "description": "Tatsächlich eingestellte Geschwindigkeit in MT/s; liegt sie über dem JEDEC-Standard, ist meist XMP/EXPO aktiv.", "type": ["integer", "null"], "minimum": 1, "maximum": 20000 },
        "manufacturer": { "$ref": "#/$defs/nullable_technical_text" },
        "part_number": { "description": "Typnummer des Moduls, keine Seriennummer.", "$ref": "#/$defs/nullable_technical_text" }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "name", "vram_mb", "driver_version", "telemetry"],
      "properties": {
        "vendor": { "enum": ["nvidia", "amd", "intel", "other"] },
        "name": { "$ref": "#/$defs/nullable_technical_text" },
        "vram_mb": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 },
        "driver_version": {
          "anyOf": [{ "type": "string", "maxLength": 40, "pattern": "^[0-9]+(\\.[0-9]+){0,7}$" }, { "type": "null" }]
        },
        "telemetry": {
          "description": "Momentaufnahme über nvidia-smi im Moment des Scans; null ohne NVIDIA-Treiber oder wenn nvidia-smi nicht antwortet.",
          "anyOf": [{ "$ref": "#/$defs/gpu_telemetry" }, { "type": "null" }]
        }
      }
    },
    "gpu_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature_c",
        "fan_percent",
        "graphics_clock_mhz",
        "graphics_clock_max_mhz",
        "memory_clock_mhz",
        "memory_clock_max_mhz",
        "power_draw_w",
        "power_limit_w",
        "power_limit_default_w",
        "power_limit_max_w",
        "pcie_gen_current",
        "pcie_gen_max",
        "pcie_width_current",
        "pcie_width_max"
      ],
      "properties": {
        "temperature_c": { "type": ["integer", "null"], "minimum": 0, "maximum": 150 },
        "fan_percent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "graphics_clock_mhz": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "graphics_clock_max_mhz": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "memory_clock_mhz": { "type": ["integer", "null"], "minimum": 0, "maximum": 50000 },
        "memory_clock_max_mhz": { "type": ["integer", "null"], "minimum": 0, "maximum": 50000 },
        "power_draw_w": { "type": ["integer", "null"], "minimum": 0, "maximum": 2000 },
        "power_limit_w": { "type": ["integer", "null"], "minimum": 0, "maximum": 2000 },
        "power_limit_default_w": { "type": ["integer", "null"], "minimum": 0, "maximum": 2000 },
        "power_limit_max_w": { "type": ["integer", "null"], "minimum": 0, "maximum": 2000 },
        "pcie_gen_current": { "description": "Im Leerlauf schaltet die Karte die PCIe-Generation oft herunter.", "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
        "pcie_gen_max": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
        "pcie_width_current": { "type": ["integer", "null"], "minimum": 1, "maximum": 32 },
        "pcie_width_max": { "type": ["integer", "null"], "minimum": 1, "maximum": 32 }
      }
    },
    "storage_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_size_gb", "system_free_gb", "pagefile_mb", "disks"],
      "properties": {
        "system_size_gb": { "description": "Größe des Systemlaufwerks.", "type": ["integer", "null"], "minimum": 0, "maximum": 1048576 },
        "system_free_gb": { "type": ["integer", "null"], "minimum": 0, "maximum": 1048576 },
        "pagefile_mb": { "description": "Aktuell zugewiesene Auslagerungsdatei; null, wenn keine eingerichtet ist oder sie nicht lesbar war.", "type": ["integer", "null"], "minimum": 0, "maximum": 1048576 },
        "disks": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/disk" } }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "media", "bus", "size_gb", "health", "firmware", "system_disk"],
      "properties": {
        "model": { "$ref": "#/$defs/nullable_technical_text" },
        "media": { "enum": ["ssd", "hdd", "unspecified"] },
        "bus": { "enum": ["nvme", "sata", "usb", "sas", "raid", "other"] },
        "size_gb": { "type": ["integer", "null"], "minimum": 0, "maximum": 1048576 },
        "health": { "description": "Zustand laut Windows (Get-PhysicalDisk.HealthStatus), keine eigene SMART-Auswertung.", "enum": ["healthy", "warning", "unhealthy", "unknown"] },
        "firmware": { "$ref": "#/$defs/nullable_technical_text" },
        "system_disk": { "type": ["boolean", "null"] }
      }
    },
    "platform_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firmware_mode", "secure_boot", "power_plan", "hardware_gpu_scheduling", "uptime_hours"],
      "properties": {
        "firmware_mode": { "enum": ["uefi", "legacy", null] },
        "secure_boot": { "type": ["boolean", "null"] },
        "power_plan": { "description": "Aktiver Energiesparplan als Windows-Standardplan; custom für jeden eigenen Plan, dessen Name nie gesendet wird.", "enum": ["balanced", "high_performance", "power_saver", "ultimate_performance", "custom", null] },
        "hardware_gpu_scheduling": { "description": "Hardwarebeschleunigte GPU-Planung (HwSchMode).", "type": ["boolean", "null"] },
        "uptime_hours": { "type": ["integer", "null"], "minimum": 0, "maximum": 100000 }
      }
    },
    "device_model": {
      "description": "Bereinigte Modellkennung. Vollständige Instanz-IDs und Seriennummern haben hier keinen Platz.",
      "type": "object",
      "additionalProperties": false,
      "required": ["bus", "vendor_id", "product_id", "subsystem_id"],
      "properties": {
        "bus": { "enum": ["pci", "usb"] },
        "vendor_id": { "type": "string", "pattern": "^[0-9A-F]{4}$" },
        "product_id": { "type": "string", "pattern": "^[0-9A-F]{4}$" },
        "subsystem_id": {
          "description": "Nur bei PCI; sonst null.",
          "anyOf": [{ "type": "string", "pattern": "^[0-9A-F]{8}$" }, { "type": "null" }]
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "model", "driver_version", "driver_date", "problem_code"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/local_id" },
        "class": {
          "enum": ["display", "network", "audio", "storage_controller", "scsi_adapter", "usb", "system", "other"]
        },
        "model": {
          "anyOf": [{ "$ref": "#/$defs/device_model" }, { "type": "null" }]
        },
        "driver_version": {
          "anyOf": [
            { "type": "string", "maxLength": 40, "pattern": "^[0-9]+(\\.[0-9]+){0,7}$" },
            { "type": "null" }
          ]
        },
        "driver_date": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/date" }, { "type": "null" }]
        },
        "problem_code": {
          "description": "Windows-ConfigManager-Fehlercode: 0 = bereit, 22 = deaktiviert, null = nicht ermittelbar.",
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "finding": {
      "description": "Gruppe gleichartiger Ereignisse. Keine rohen Ereignisnachrichten, Dateipfade oder Dumps.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "event_id", "count", "first_seen", "last_seen", "severity", "device_ref"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/local_id" },
        "source": {
          "description": "Exakter Name der Windows-Ereignisquelle.",
          "enum": [
            "Display",
            "nvlddmkm",
            "amdwddmg",
            "Microsoft-Windows-Kernel-PnP",
            "Microsoft-Windows-DriverFrameworks-UserMode",
            "Microsoft-Windows-WHEA-Logger",
            "disk",
            "stornvme",
            "storahci",
            "Microsoft-Windows-WLAN-AutoConfig"
          ]
        },
        "event_id": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "first_seen": { "$ref": "common.schema.json#/$defs/timestamp" },
        "last_seen": { "$ref": "common.schema.json#/$defs/timestamp" },
        "severity": { "enum": ["critical", "error", "warning", "info"] },
        "device_ref": {
          "description": "id eines Eintrags in devices oder null, wenn keine Zuordnung vorliegt.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/local_id" }, { "type": "null" }]
        }
      }
    },
    "collection_status": {
      "description": "complete: vollständig erfasst. truncated: wegen Limit gekürzt. failed: Erfassung fehlgeschlagen. unavailable: Quelle auf diesem PC nicht vorhanden oder nicht aktiv. Alles außer complete bedeutet nie „gesund“.",
      "enum": ["complete", "truncated", "failed", "unavailable"]
    },
    "collection": {
      "description": "Technischer Erfassungsstatus je Bereich, damit Lücken nicht als unauffälliger Befund gelesen werden.",
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware", "devices", "system_events", "wlan_events"],
      "properties": {
        "hardware": { "$ref": "#/$defs/collection_status" },
        "devices": { "$ref": "#/$defs/collection_status" },
        "system_events": { "$ref": "#/$defs/collection_status" },
        "wlan_events": { "$ref": "#/$defs/collection_status" }
      }
    },
    "wow": {
      "description": "Minimaler, vom Nutzer genannter Spielkontext ohne Account-, Charakter- oder Realm-Bezug.",
      "type": "object",
      "additionalProperties": false,
      "required": ["game_build", "problem_scope", "addon_test"],
      "properties": {
        "game_build": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9]{1,2}\\.[0-9]{1,2}\\.[0-9]{1,2}(\\.[0-9]{1,6})?$" },
            { "type": "null" }
          ]
        },
        "problem_scope": { "enum": ["wow_only", "also_elsewhere", "unknown"] },
        "addon_test": { "enum": ["yes", "no", "unknown"] }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy_notice_version", "accepted_at", "upload_approved", "external_ai_allowed"],
      "properties": {
        "privacy_notice_version": { "$ref": "common.schema.json#/$defs/version_label" },
        "accepted_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "upload_approved": { "const": true },
        "external_ai_allowed": {
          "description": "false: ausschließlich manuelle Bearbeitung, kein Datenversand an einen Modellanbieter.",
          "type": "boolean"
        }
      }
    }
  }
}
