{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Freigegebenes Ergebnis",
  "description": "Von einem Menschen freigegebene, unveränderliche Ergebnisrevision. Alle Texte sind inert anzuzeigender Plaintext. Es gibt bewusst keine ausführbaren Felder, Skripte oder Wahrscheinlichkeitswerte. Serialisiert höchstens 65536 Bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_schema_version",
    "case_id",
    "scan_id",
    "report_sha256",
    "revision",
    "released_at",
    "origin",
    "summary",
    "facts",
    "hypotheses",
    "next_steps",
    "open_questions",
    "warnings",
    "sources"
  ],
  "properties": {
    "result_schema_version": { "enum": ["1.0"] },
    "case_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "scan_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "report_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "released_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "origin": { "enum": ["human", "ai_assisted_human_reviewed"] },
    "summary": { "$ref": "#/$defs/text_2000" },
    "facts": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/fact" }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "next_steps": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/next_step" }
    },
    "open_questions": {
      "description": "Rückfragen an den Nutzer, wenn die Datengrundlage für eine Aussage fehlt.",
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/text_1000" }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/text_1000" }
    },
    "sources": {
      "description": "Optionale, geprüfte offizielle Quellen. Der Client öffnet sie nur nach bewusster Nutzeraktion.",
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "text_200": { "$ref": "common.schema.json#/$defs/free_text", "minLength": 1, "maxLength": 200 },
    "text_1000": { "$ref": "common.schema.json#/$defs/free_text", "minLength": 1, "maxLength": 1000 },
    "text_2000": { "$ref": "common.schema.json#/$defs/free_text", "minLength": 1, "maxLength": 2000 },
    "text_4000": { "$ref": "common.schema.json#/$defs/free_text", "minLength": 1, "maxLength": 4000 },
    "reference": {
      "description": "Beleg im zugehörigen Bericht.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["finding", "device"] },
            "id": { "$ref": "common.schema.json#/$defs/local_id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pointer"],
          "properties": {
            "kind": { "const": "report_field" },
            "pointer": {
              "description": "JSON Pointer auf ein Feld des Berichts, zum Beispiel /hardware/bios_version.",
              "type": "string",
              "maxLength": 100,
              "pattern": "^(/[a-z0-9_]+)+$"
            }
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "references"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/local_id" },
        "text": { "$ref": "#/$defs/text_1000" },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "hypothesis": {
      "description": "Ausdrücklich unbewiesene Vermutung.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "proven", "fact_refs"],
      "properties": {
        "text": { "$ref": "#/$defs/text_1000" },
        "proven": { "const": false },
        "fact_refs": {
          "description": "ids der Fakten, auf die sich die Vermutung stützt.",
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/local_id" }
        }
      }
    },
    "next_step": {
      "description": "Manuell auszuführende Empfehlung. Der Client führt nichts davon selbst aus.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "rationale",
        "instructions",
        "risk_class",
        "required_privileges",
        "expected_outcome",
        "rollback",
        "abort_condition"
      ],
      "properties": {
        "title": { "$ref": "#/$defs/text_200" },
        "rationale": { "$ref": "#/$defs/text_1000" },
        "instructions": { "$ref": "#/$defs/text_4000" },
        "risk_class": { "enum": ["read_only", "reversible_change", "expert_only"] },
        "required_privileges": { "enum": ["none", "standard_user", "administrator"] },
        "expected_outcome": { "$ref": "#/$defs/text_1000" },
        "rollback": {
          "anyOf": [{ "$ref": "#/$defs/text_1000" }, { "type": "null" }]
        },
        "abort_condition": {
          "anyOf": [{ "$ref": "#/$defs/text_1000" }, { "type": "null" }]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "$ref": "#/$defs/text_200" },
        "url": {
          "description": "Nur HTTPS, ohne Benutzerangaben und ohne Port.",
          "type": "string",
          "maxLength": 500,
          "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(/[!-~]*)?$"
        }
      }
    }
  }
}
