{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request von POST /cases/{case_id}/feedback",
  "description": "Rückmeldung zu einer freigegebenen Ergebnisrevision. Löst keine neue KI-Anfrage aus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "note", "result_revision"],
  "properties": {
    "outcome": { "enum": ["improved", "unchanged", "worse", "not_tried"] },
    "note": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/free_text", "minLength": 1, "maxLength": 2000 },
        { "type": "null" }
      ]
    },
    "result_revision": { "type": "integer", "minimum": 1, "maximum": 1000 }
  }
}
