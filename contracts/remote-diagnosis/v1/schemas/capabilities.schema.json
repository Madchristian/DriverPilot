{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antwort von GET /capabilities",
  "description": "Öffentliche, minimale Protokollinformationen. Enthält weder Secrets noch Modell- oder Infrastrukturdetails.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "report_schema_versions",
    "result_schema_version",
    "max_upload_bytes",
    "max_scan_age_seconds",
    "max_future_skew_seconds",
    "case_retention_days",
    "privacy_notice",
    "external_ai_offered"
  ],
  "properties": {
    "protocol_version": { "type": "string", "pattern": "^1\\.[0-9]{1,3}$" },
    "report_schema_versions": {
      "description": "Vom Server angenommene Werte für schema_version des Berichts.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$" }
    },
    "result_schema_version": { "type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$" },
    "max_upload_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
    "max_scan_age_seconds": { "type": "integer", "minimum": 1, "maximum": 900 },
    "max_future_skew_seconds": { "type": "integer", "minimum": 0, "maximum": 300 },
    "case_retention_days": { "type": "integer", "minimum": 1, "maximum": 7 },
    "privacy_notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "text"],
      "properties": {
        "version": { "$ref": "common.schema.json#/$defs/version_label" },
        "text": {
          "description": "Vollständiger Hinweistext mit Empfänger, Zweck, Löschfrist und gegebenenfalls Modellanbieter. Der Client zeigt genau diesen Text vor der Zustimmung.",
          "$ref": "common.schema.json#/$defs/free_text",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "external_ai_offered": {
      "description": "false: Der Client bietet die KI-Option nicht an und sendet external_ai_allowed=false.",
      "type": "boolean"
    }
  }
}
