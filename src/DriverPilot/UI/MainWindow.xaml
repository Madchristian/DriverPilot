<Window x:Class="DriverPilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DriverPilot" Width="1280" Height="850" MinWidth="1000" MinHeight="700" Background="#0B1423" WindowStartupLocation="CenterScreen">
 <Grid Background="#0B1423"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101B2D" BorderBrush="#233047" BorderThickness="0,0,1,0"><DockPanel Margin="22,30">
   <StackPanel DockPanel.Dock="Top" Margin="0,0,0,38"><TextBlock Text="◈  DriverPilot" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="DEIN PC. GUT BETREUT." FontSize="10" Foreground="#7E98BC" Margin="3,9,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Background="#19332F" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="●  Stabilität zuerst" Foreground="#86DEC0" FontWeight="SemiBold"/><TextBlock Text="Neustarts nur durch dich" Foreground="#93B8B0" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="LOKAL · WINDOWS · v0.3" FontSize="10" Foreground="#647C9C" Margin="4,20,0,0"/></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation"><Button Content="Übersicht" Tag="0" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,10"/><Button Content="Hardware &amp; Treiber" Tag="1" Click="Navigate" Margin="0,0,0,10"/><Button Content="Probleme" Tag="2" Click="Navigate" Margin="0,0,0,10"/><Button Content="Treiberupdates" Tag="3" Click="Navigate" Margin="0,0,0,10"/><Button Content="Hersteller &amp; Firmware" Tag="7" Click="Navigate" Margin="0,0,0,10"/><Button Content="Codex-Assistent" Tag="4" Click="Navigate" Margin="0,0,0,10"/><Button Content="Verlauf" Tag="5" Click="Navigate" Margin="0,0,0,10"/><Button Content="Einstellungen" Tag="6" Click="Navigate" Margin="0,0,0,10"/></StackPanel></ScrollViewer>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="32,26,32,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="Dein System im Blick" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Hardware, Treiber und Windows-Meldungen an einem Ort." Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><Button x:Name="ScanButton" Content="Jetzt prüfen" Click="ScanClick" Background="#366BE8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"/></Grid>
   <Grid x:Name="PageHost" Grid.Row="1">
    <ScrollViewer x:Name="Overview" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}" Background="#172D48" Margin="0,0,0,20"><Grid><StackPanel><TextBlock Text="DEIN STABILITÄTSPROFIL" FontSize="11" Foreground="#83BCFF"/><TextBlock x:Name="HealthTitle" Text="System wird geprüft …" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,10"/><TextBlock x:Name="HealthDetail" Text="Geräte erfassen und Windows-Ereignisse auswerten." Foreground="#B0C3DD" TextWrapping="Wrap" MaxWidth="610" HorizontalAlignment="Left"/></StackPanel></Grid></Border>
     <UniformGrid Columns="3" Margin="0,0,0,20"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="ERKANNTE GERÄTE" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DeviceCount" Text="—" FontSize="34" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="HANDLUNGSBEDARF" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="IssueCount" Text="—" FontSize="34" Foreground="#FFC87A" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="UPDATE-AUTOPILOT" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AutoStatus" Text="Nicht eingerichtet" FontSize="17" Margin="0,19,0,10"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Dein Gaming-PC" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HardwareSummary" Text="Hardware wird geladen …" LineHeight="29" TextWrapping="Wrap" Foreground="#B8C9DF" Margin="0,14,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Automatisch aufmerksam. Du behältst die Kontrolle." FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Geräte &amp; Ereignisse alle 2 Minuten · Updates täglich&#x0a;Neue Pakete mindestens 14 Tage beobachten · Neustarts immer manuell" Foreground="{StaticResource Muted}" LineHeight="25" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="Überwachung läuft im Infobereich weiter. Die Update-Automatik benötigt eine einmalige Einrichtung." Foreground="#83BCFF" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="HardwarePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="DeviceFilter" TextChanged="FilterChanged" ToolTip="Gerät, Hersteller oder Treiberversion suchen" Margin="0,0,0,16"/><DataGrid x:Name="DeviceGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Gerät" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Klasse" Binding="{Binding Class}" Width="105"/><DataGridTextColumn Header="Treiber" Binding="{Binding Version}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="145"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Ausgewähltes Gerät auf Version halten" Click="PinDevice"/><Button x:Name="SystemReportButton" Content="Systembericht prüfen / teilen …" Click="SystemReportClick" IsEnabled="False" ToolTip="Datensparsame Vorschau aus einem frischen Scan. Keine automatische Übertragung."/></WrapPanel></Grid>
    <Grid x:Name="IssuesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ereignisse der letzten 24 Stunden. Eine Meldung allein beweist keinen Treiberdefekt." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/><ListBox x:Name="FindingsList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Severity}" Foreground="#FFC87A" FontSize="11"/><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,8"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#B5C6DC"/><TextBlock Text="{Binding Time}" Foreground="#778EAF" FontSize="11" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Mit Codex erklären" Click="ExplainFinding"/><Button Content="Als bekannt markieren" Click="IgnoreClick"/><Button Content="Zurücksetzen" Click="ResetIgnoredClick"/></StackPanel></Grid>
    <Grid x:Name="UpdatesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Quelle: Windows Update. Herstellerpakete außerhalb dieses Katalogs werden noch nicht automatisch installiert." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button x:Name="UpdateButton" Content="Nach Treiberupdates suchen" Click="UpdatesClick" HorizontalAlignment="Left" Margin="0,15,0,0"/><TextBlock x:Name="UpdateStatus" Text="Noch keine Suche durchgeführt." Foreground="#83BCFF" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel><DataGrid x:Name="UpdateGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Paket" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Hersteller" Binding="{Binding Manufacturer}" Width="130"/><DataGridTextColumn Header="Klasse" Binding="{Binding Class}" Width="90"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Kontrollierte Wartung" FontSize="17"/><TextBlock Text="Der eingerichtete Auftrag sucht regelmäßig und installiert im eingestellten Wartungsfenster bei Leerlauf. Er sichert vorhandene Treiber und stoppt bei Fehlern oder ausstehendem Neustart. Firmware und Speichertreiber sind ausgenommen." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/><Button Content="Ausgewähltes Update sperren" Click="BlockUpdate" HorizontalAlignment="Left" Margin="0,12,0,12"/><TextBlock x:Name="WorkerStatus" Text="Automatik noch nicht eingerichtet." Foreground="#83BCFF" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></Grid>
    <Grid x:Name="AiPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,15"><StackPanel Orientation="Horizontal"><Button Content="Mit ChatGPT anmelden" Click="LoginClick"/><Button Content="Verbindung prüfen" Click="AccountClick"/><Button Content="Chat löschen" Click="ClearChat"/></StackPanel><TextBlock x:Name="AccountStatus" Text="Codex wird lokal über den offiziellen App Server verbunden." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/><TextBlock Text="Beim Senden werden Hardware, Treiberversionen und Diagnosehinweise an Codex übermittelt. Keine Seriennummern oder vollständigen Ereignistexte." Foreground="#8297B5" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><TextBox x:Name="ChatOutput" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="Frag mich zu deinem PC oder lass dir einen Befund erklären."/><Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatInput" Text="Analysiere meinen Treiberstatus mit Schwerpunkt Stabilität." AcceptsReturn="True" MaxHeight="110" TextWrapping="Wrap"/><Button x:Name="SendButton" Grid.Column="1" Content="Senden" Background="#366BE8" Click="SendClick" Margin="12,0,0,0"/></Grid></Grid>
    <Grid x:Name="ManufacturersPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,16"><TextBlock Text="Versionsvergleich für unterstützte Herstellerquellen. BIOS und Firmware bleiben manuell. Offene oder blockierte Quellen gelten niemals als „aktuell“." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Button x:Name="ManufacturerButton" Content="Herstellerquellen prüfen" Click="ManufacturersClick" HorizontalAlignment="Left" Background="#366BE8" Margin="0,14,0,10"/><TextBlock x:Name="ManufacturerStatus" Text="Noch keine Herstellersuche durchgeführt. Automatische Prüfung täglich, solange DriverPilot läuft." TextWrapping="Wrap" Foreground="#83BCFF"/></StackPanel>
     <ListBox x:Name="ManufacturerList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding Category}" FontSize="11" Foreground="#83BCFF"/><TextBlock Text="{Binding Device}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock Text="{Binding Status}" Foreground="#FFC87A" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,12"><StackPanel Margin="0,0,28,0"><TextBlock Text="INSTALLIERT" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Installed}" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="0,0,28,0"><TextBlock Text="ANGEBOTEN" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Available}" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="VERÖFFENTLICHT" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ReleaseDate}" Margin="0,5,0,0"/></StackPanel></WrapPanel><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="#AABDD7"/><Button Content="Offizielle Quelle öffnen ↗" Tag="{Binding SourceUrl}" Click="ManufacturerSourceClick" HorizontalAlignment="Left" Margin="0,14,0,0"/><Button Content="Geführte Prüfung / Notiz" Click="FirmwareGuide" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
    <DataGrid x:Name="HistoryPage" Visibility="Collapsed"><DataGrid.Columns><DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="145"/><DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="155"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Überwachung &amp; Hinweise" FontSize="18"/><CheckBox x:Name="MonitorBox" Content="Geräte und Windows-Ereignisse regelmäßig prüfen" Checked="PreferencesChanged" Unchecked="PreferencesChanged"/><CheckBox x:Name="NotifyBox" Content="Windows-Benachrichtigungen bei neuen Problemen" Checked="PreferencesChanged" Unchecked="PreferencesChanged"/><CheckBox x:Name="StartupBox" Content="DriverPilot bei der Windows-Anmeldung starten" Checked="StartupChanged" Unchecked="StartupChanged"/><TextBlock Text="Schließen minimiert in den Infobereich. Beenden ist über das dortige Menü möglich." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Update-Autopilot einrichten" FontSize="18"/><TextBlock Text="Einmalige Windows-Administratorfreigabe: installiert die App geschützt unter Programme und richtet einen täglichen Wartungsauftrag ein. Keine automatischen Neustarts. Pakete werden frühestens 14 Tage nach der ersten Beobachtung installiert." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Automatik einrichten" Click="SetupClick" Background="#366BE8"/><Button Content="Automatik deaktivieren" Click="DisableClick"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Stabilitätsregeln" FontSize="18"/><TextBlock Text="• Neustart ausschließlich durch dich&#x0a;• Mindestens 14 Tage Beobachtungszeit&#x0a;• Installation nur bei Leerlauf, keine parallelen Pakete&#x0a;• Firmware, BIOS und Speichertreiber bleiben manuell&#x0a;• Fehler stoppen weitere Installationen&#x0a;• KI kann die festen Installationsregeln nicht überschreiben" LineHeight="28" Foreground="#B5C6DC" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <TextBlock x:Name="StatusLine" Grid.Row="2" Text="Bereit" Foreground="#8297B5" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
